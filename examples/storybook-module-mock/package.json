{
  "name": "storybook-module-mock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "author": "SoraKumo <info@croud.jp>",
  "license": "MIT",
  "repository": "https://github.com/SoraKumo001/storybook-module-mock",
  "scripts": {
    "test": "pnpm run storybook:build && npm-run-all -p -r storybook:start storybook:test",
    "storybook": "rimraf node_modules/.cache && storybook dev -p 9001",
    "build-storybook": "storybook build",
    "storybook:build": "rimraf node_modules/.cache && storybook build",
    "storybook:start": "http-server -s -p 9001 storybook-static",
    "storybook:test": "test-storybook --url http://127.0.0.1:9001 --coverage",
    "sf": "scaffold create -t https://github.com/node-libraries/scaffold/tree/master/templates/storybook8",
    "lint": "eslint --fix ./src",
    "lint:fix": "eslint --fix ./src"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/styled-engine": "^7.3.7",
    "next": "16.1.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@node-libraries/scaffold": "^1.0.5",
    "@storybook/addon-coverage": "3.0.0",
    "@storybook/nextjs": "10.2.0",
    "@storybook/test-runner": "0.24.2",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "chromatic": "^13.3.5",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "10.2.0",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "playwright": "1.58.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.2",
    "sass": "^1.97.3",
    "storybook": "10.2.0",
    "storybook-addon-module-mock": "workspace:*",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
